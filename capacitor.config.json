{
  "appId": "in.texwebsolution.crm",
  "appName": "TW-CRM",
  "webDir": "public",
  "bundledWebRuntime": false,
  "appendUserAgent": "Capacitor TW-CRM",
  "server": {
    "url": "https://www.texwebsolution.in/crm/dashboard",
    "cleartext": true,
    "allowNavigation": [
      "texwebsolution.in",
      "*.texwebsolution.in",
      "*.supabase.co",
      "localhost"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
